{
  "name": "ask-grok-extension",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w grok-bridge && npm run build -w vocab-study",
    "build:grok": "npm run build -w grok-bridge",
    "build:vocab": "npm run build -w vocab-study",
    "dev:grok": "npm run dev -w grok-bridge",
    "dev:vocab": "npm run dev -w vocab-study",
    "clean": "npm run clean -w grok-bridge && npm run clean -w vocab-study",
    "link-extensions": "node scripts/link-extensions.mjs"
  },
  "devDependencies": {
    "vite": "^6.1.1"
  }
}
