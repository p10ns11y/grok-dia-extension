{
  "manifest_version": 3,
  "name": "Vocab Study",
  "version": "1.0.0",
  "description": "Save words from reading and review with spaced repetition. Local only.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Vocab Study"
  },
  "options_page": "study.html",
  "icons": {
    "128": "icon.png"
  }
}
